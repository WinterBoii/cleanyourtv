<?xml version="1.0" encoding="utf-8"?>
<!-- Focus is a solid light plate with no glow (CleanFrame); the applied choice keeps a thin outline. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="140">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFF3F3EF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1FF6F1E7" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="#C2F6F1E7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14F6F1E7" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
